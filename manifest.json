{
  "id": "deepseek",
  "pluginType": "harness-adapter",
  "name": "DeepSeek Harness",
  "summary": "Drives the dsh web server over loopback; sessions, approvals and resume are the harness's own.",
  "icons": {
    "light": "logo.svg",
    "dark": "logo.svg"
  },
  "version": "0.1.10",
  "protocol": 0,
  "command": [
    "node",
    "deepseek-adapter.cjs"
  ],
  "runtime": {
    "package": "@deepseek-ai/dsh",
    "version": "0.2.0-rc.2",
    "command": [
      "node",
      "runtime/lib/bin.js"
    ]
  },
  "extensions": [
    "dsh-presets",
    "hub-command-approval"
  ],
  "capabilities": [
    "models",
    "runtime",
    "providers",
    "presets",
    "plan",
    "review",
    "fork",
    "stats",
    "compact",
    "rename",
    "skills"
  ],
  "release": {
    "repository": "sabishii-me/agent-hub-harness-adapter-deepseek"
  }
}
